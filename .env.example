# Exchange selection: "binance" or "bitget"
EXCHANGE=binance

# Binance API (USDⓈ-M Futures)
BINANCE_API_KEY=your_api_key
BINANCE_API_SECRET=your_api_secret
BINANCE_TESTNET=true

# Bitget API (USDT-M Futures)
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=
BITGET_TESTNET=0

# Database / cache
DATABASE_URL=postgresql://liquidx:liquidx@localhost:5432/cryptogate
REDIS_URL=redis://localhost:6379

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Auth (dashboard login)
NEXTAUTH_SECRET=change_me
NEXTAUTH_URL=http://localhost:3000
ADMIN_USER=admin
ADMIN_PASS=admin
API_SECRET=change_me
# Server-side only: where the web app reaches the agent (docker-compose overrides this)
AGENT_INTERNAL_URL=http://localhost:4000

# Ports
AGENT_PORT=4000
WEB_PORT=3000

# Agent runtime
LIVE=0
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
LEVERAGE=20
RISK_PER_TRADE=0.25
MAX_DAILY_LOSS=0.50
MAX_CONCURRENT_POSITIONS=3
LOG_LEVEL=info

# Web -> agent
NEXT_PUBLIC_WS_URL=http://localhost:4000
