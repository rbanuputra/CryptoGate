# Replace :80 with your domain (e.g. liquidx.example.com) for automatic HTTPS
:80 {
	# Only the realtime socket reaches the agent directly (token-authenticated).
	# REST goes through the web app's /api/agent proxy, which holds API_SECRET.
	handle /socket.io/* {
		reverse_proxy agent:4000
	}
	handle {
		reverse_proxy web:3000
	}
}
